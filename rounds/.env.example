# Optional public read-only catalog URL. Blank uses the bundled library.
# Production EAS builds set this to the public Firestore catalog in eas.json.
# Never put private keys or service-account credentials in EXPO_PUBLIC variables.
EXPO_PUBLIC_CONTENT_API_URL=

# Optional development-only content endpoint. Ignored in production builds.
EXPO_PUBLIC_PREVIEW_CONTENT_API_URL=
