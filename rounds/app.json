{
  "expo": {
    "name": "Rounds",
    "slug": "rounds",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/rounds-icon.png",
    "scheme": "rounds",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/brand/rounds-icon.png",
      "bundleIdentifier": "com.dailydosemd.rounds",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#24272F",
        "foregroundImage": "./assets/brand/rounds-adaptive.png",
        "monochromeImage": "./assets/brand/rounds-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dailydosemd.rounds",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/rounds-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/rounds-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#24272F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cb94e210-74eb-4d84-9c0f-b3e5340de5b9"
      }
    }
  }
}
