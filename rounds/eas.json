{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_PREVIEW_CONTENT_API_URL": "https://rounds-b01c3.web.app/preview-catalog.json"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": { "buildType": "app-bundle" },
      "env": {
        "ROUNDS_RELEASE_CHECK": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
