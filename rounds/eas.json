{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_PREVIEW_CONTENT_API_URL": "https://firestore.googleapis.com/v1/projects/rounds-b01c3/databases/(default)/documents/published/preview"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_PREVIEW_CONTENT_API_URL": "https://firestore.googleapis.com/v1/projects/rounds-b01c3/databases/(default)/documents/published/preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_CONTENT_API_URL": "https://firestore.googleapis.com/v1/projects/rounds-b01c3/databases/(default)/documents/published/catalog"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    }
  },
  "submit": {
    "production": {}
  }
}
